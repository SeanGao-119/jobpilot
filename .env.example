# PostgreSQL / Supabase connection string. Never commit real credentials.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
JOBPILOT_REPOSITORY_ROOT=

# Gmail queries used by the automatic SEEK + LinkedIn opportunity sync.
GMAIL_SEEK_QUERY="from:seek newer_than:14d"
GMAIL_LINKEDIN_QUERY="{from:jobalerts-noreply@linkedin.com from:jobs-noreply@linkedin.com} newer_than:14d"
