# PostgreSQL / Supabase connection string. Never commit real credentials.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
JOBPILOT_REPOSITORY_ROOT=

# Gmail queries used by the automatic SEEK + LinkedIn opportunity sync.
GMAIL_SEEK_QUERY="from:seek newer_than:14d"
GMAIL_LINKEDIN_QUERY="{from:jobalerts-noreply@linkedin.com from:jobs-noreply@linkedin.com} newer_than:14d"

# Optional career-ops evaluation engine. Point this at a separate local checkout
# of https://github.com/career-ops-hq/career-ops. JobPilot creates an isolated
# temporary data root, so career-ops never writes directly to JobPilot data.
JOBPILOT_CAREER_OPS_ROOT=/absolute/path/to/career-ops
JOBPILOT_CAREER_OPS_NODE=node
JOBPILOT_CAREER_OPS_TIMEOUT=300

# The adapter reuses JobPilot's existing DeepSeek configuration and maps it to
# career-ops' OpenAI-compatible evaluator in the child process.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
