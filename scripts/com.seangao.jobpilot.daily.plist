<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.seangao.jobpilot.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/gaozilin/jobpilot/scripts/jobpilot-daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gaozilin/jobpilot</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/gaozilin/.jobpilot/logs/launchd-out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gaozilin/.jobpilot/logs/launchd-error.log</string>
</dict>
</plist>
