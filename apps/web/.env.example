# PostgreSQL (server-side only)
# Prefer split credentials locally when passwords contain URL-reserved characters.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD="CHANGE_ME"

# Optional alternative to the split DB_* configuration.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

# AI provider. DeepSeek is the default.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY="CHANGE_ME"
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional live web-search provider for Salary Intelligence.
# Without this, JobPilot can only use salary evidence already ingested into its jobs table.
# SERPER_API_KEY="CHANGE_ME"
